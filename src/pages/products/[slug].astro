---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const products = import.meta.glob('../../products/*.md', { eager: true });
  return Object.entries(products).map(([path, p]: [string, any]) => {
    const filename = path.split('/').pop() || '';
    const slug = p.frontmatter?.slug || filename.replace(/\.md$/, '');
    return { params: { slug }, props: { product: p } };
  });
}

const { product } = Astro.props;
const { Content, frontmatter } = product;
---

<Base title={frontmatter.name} description={frontmatter.description}>
  <main class="container article">
    <article>
      <header class="article-header">
        <div class="product-thumb large">{frontmatter.emoji || '🛒'}</div>
        <h1>{frontmatter.name}</h1>
        <p class="product-price large">{frontmatter.price}</p>
        {frontmatter.buy_url && (
          <a class="buy-btn" href={frontmatter.buy_url} target="_blank" rel="noopener">立即購買</a>
        )}
      </header>
      <div class="article-body">
        <Content />
      </div>
    </article>
    <p class="back"><a href={`${import.meta.env.BASE_URL}shop/`}>← 返去商店</a></p>
  </main>
</Base>
