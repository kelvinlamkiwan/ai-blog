---
import Base from '../layouts/Base.astro';

const products = Object.values(
  import.meta.glob('../products/*.md', { eager: true })
);
---

<Base title="商店" description="AI 相關產品同服務">
  <main class="container">
    <section class="hero">
      <h1>🛍️ 商店</h1>
      <p class="subtitle">電子書、諮詢、工作坊等 AI 產品同服務。</p>
    </section>

    <div class="product-grid">
      {products.map((p: any) => (
        <a class="product-card" href={`${import.meta.env.BASE_URL}products/${p.frontmatter.slug}/`}>
          <div class="product-thumb">{p.frontmatter.emoji || '🛒'}</div>
          <div class="product-info">
            <h2>{p.frontmatter.name}</h2>
            <p class="product-price">{p.frontmatter.price}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>
